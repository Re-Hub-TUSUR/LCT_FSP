# Copy to `.env` (git-ignored) and fill in. Never commit real values.
# One file serves docker compose, the backend (pydantic-settings) and Vite (envDir = repo root).

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=kadry
POSTGRES_USER=kadry
# Required. Any local password; production values live in the secret store.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- Backend ---
APP_ENV=development
LOG_LEVEL=INFO
# Used when running the backend outside compose (compose builds its own URL for the `db` host).
DATABASE_URL=postgresql+asyncpg://kadry:CHANGE_ME@localhost:5432/kadry
# Required, min 32 chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=30
# Comma-separated. Empty = no CORS (same-origin via Vite proxy / nginx is the default setup).
CORS_ORIGINS=
# Resend (https://resend.com). Empty key: in development the 6-digit code is written to the API log.
# RESEND_FROM must be a verified sender. onboarding@resend.dev works for the Resend test inbox.
RESEND_API_KEY=
RESEND_FROM=КАДРЫ <onboarding@resend.dev>

# Запуск кода в тестировании (https://onlinecompiler.io/docs). Пустой ключ: вопросы работают,
# задачи на код отвечают 503.
ONLINECOMPILER_API_KEY=
# Password of the demo accounts created by `python -m app.seed`. Empty = the default from backend/README.md.
SEED_USER_PASSWORD=

# --- Frontend (only VITE_* is exposed to the browser bundle — no secrets here) ---
VITE_API_URL=/api/v1
# Vite dev server proxies /api to this address.
DEV_API_PROXY_TARGET=http://localhost:8000
