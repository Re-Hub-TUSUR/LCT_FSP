# Copy to `.env` (git-ignored) and fill in. Never commit real values.
# One file serves docker compose, the backend (pydantic-settings) and Vite (envDir = repo root).

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=kadry
POSTGRES_USER=kadry
# Required. Any local password; production values live in the secret store.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- Backend ---
APP_ENV=development
LOG_LEVEL=INFO
# Used when running the backend outside compose (compose builds its own URL for the `db` host).
DATABASE_URL=postgresql+asyncpg://kadry:CHANGE_ME@localhost:5432/kadry
# Required, min 32 chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=30
# Comma-separated SPA origins. Empty = CORS off (same-origin via the Vite proxy or nginx).
# Never "*": the refresh cookie is sent with credentials, so only listed origins are trusted.
CORS_ORIGINS=
# Resend (https://resend.com). Empty key: in development the 6-digit code is written to the API log.
# RESEND_FROM must be a verified sender. onboarding@resend.dev works for the Resend test inbox.
# The live domain айти-кадры.рф is xn----7sbbqrfj4cm0h.xn--p1ai in DNS and in the address.
RESEND_API_KEY=
RESEND_FROM=КАДРЫ <onboarding@resend.dev>

# Запуск кода в тестировании (https://onlinecompiler.io/docs). Пустой ключ: вопросы работают,
# задачи на код отвечают 503.
ONLINECOMPILER_API_KEY=
# Password of the demo accounts created by `python -m app.seed`. Empty = the default from backend/README.md.
SEED_USER_PASSWORD=
# Candidate search. Compose sets it for the backend container; outside compose point it at a
# running cluster (http://localhost:9200) or leave empty to search the database.
ELASTICSEARCH_URL=
# Minutes between checks of saved searches for new results (notifications); 0 = off.
SAVED_SEARCH_ALERT_MINUTES=5
# Live notifications (chat, likes, meetings) fan out per user — app/services/broker.py. Empty:
# one in-process worker, fine as deployed today. redis://host:6379/0: the same fan-out works
# across several backend workers or replicas.
BROKER_URL=
# Language models through RouterAI (https://routerai.ru/settings/keys); only Russian models (Yandex).
# Empty key: the resume upload answers 503 and grade tests are confirmed without the AI interview.
ROUTERAI_API_KEY=
RESUME_PARSER_MODEL=yandex/aliceai-llm-flash
INTERVIEW_MODEL=yandex/aliceai-llm-flash
# FSP ID (Keycloak OIDC) and the FSP participant registry, see docs/FSP_INTEGRATION.md.
# `mock` emulates both inside the API; `keycloak` talks to the real realm and registry.
FSP_ID_MODE=mock
# Realm URL. Mock: the realm served by this API (relative to the site).
FSP_ID_ISSUER=/api/v1/mock/fsp-id/realms/fsp
FSP_ID_CLIENT_ID=kadry
FSP_ID_CLIENT_SECRET=
# The SPA page FSP ID returns to; CORS_ORIGINS + the same path are accepted as well, and in
# mock mode so is any local address (localhost, 127.0.0.1, a LAN IP) on any port.
FSP_ID_REDIRECT_URI=http://localhost:5173/profile/fsp/callback
# Registry API base URL (keycloak mode only).
FSP_REGISTRY_URL=

# Yandex ID, authorization code (not the instant-login widget). Empty id hides the button
# and the API answers 404. Register the app: https://yandex.ru/dev/id/doc/ru/register-client
# Type «Для авторизации пользователей», platform «Веб-сервисы». Permissions: «Логин, имя и фамилия»,
# «Портрет», «Адрес электронной почты». Redirect URI: http://localhost:8080/auth/yandex/callback
# and the live https://<domain>/auth/yandex/callback. How to fill the form: https://yandex.ru/dev/id/doc/ru/register-auth
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:8080/auth/yandex/callback

# Admin subdomain. Point admin.айти-кадры.рф (punycode admin.xn----7sbbqrfj4cm0h.xn--p1ai)
# at port 8082 the same way docs.айти-кадры.рф points at 8081.
# Browser dialog: comma-separated name:password. A password must not contain a comma.
ADMIN_GATE_USERS=
# Shared by the admin nginx and the API. 16+ characters, only A-Za-z0-9_-.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_GATE_SECRET=
# Platform account that opens after the dialog. Password is at least 12 characters.
# docker compose exec backend python -m app.admin.create_admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ATS connector. mock = in-process demo. fixture = JSON provider with different field names.
# A documented ATS is added as another adapter and another value here. 0 disables the background poll.
ATS_MODE=mock
ATS_POLL_SECONDS=60

# --- Frontend (only VITE_* is exposed to the browser bundle — no secrets here) ---
VITE_API_URL=/api/v1
# Vite dev server proxies /api to this address.
DEV_API_PROXY_TARGET=http://localhost:8000
