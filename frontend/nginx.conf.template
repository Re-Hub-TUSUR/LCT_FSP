# Port 80 is the public site: a client-supplied gate header is dropped.
# Port 81 is unpublished and used only by the admin proxy.
map $server_port $forwarded_admin_gate {
    default "";
    81 $http_x_admin_gate;
}

server {
    listen 80;
    listen 81;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;

    # Resolve the backend at request time so the image also starts without a backend container.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    # Same-origin API: no CORS needed in the containerised setup. Also exposes /api/docs (Swagger).
    location /api/ {
        set $backend_upstream ${BACKEND_UPSTREAM};
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Admin-Gate $forwarded_admin_gate;
        client_max_body_size 10m;
    }

    # Vite fingerprints everything under /assets, so it can be cached forever
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # SPA fallback; index.html itself must never be cached
    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        try_files $uri $uri/ /index.html;
    }
}
