# Port 80 is the public site: a client-supplied gate header is dropped.
# Port 81 is unpublished and used only by the admin proxy.
map $server_port $forwarded_admin_gate {
    default "";
    81 $http_x_admin_gate;
}

# Rate limits per client. In production a host nginx (TLS) and the admin proxy stand in front,
# so the client address comes from X-Forwarded-For of those private-network hops.
limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=streams:10m;

server {
    listen 80;
    listen 81;
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from 127.0.0.1;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    limit_req_status 429;
    limit_conn_status 429;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;

    # Resolve the backend at request time so the image also starts without a backend container.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    # Same-origin API: no CORS needed in the containerised setup. Also exposes /api/docs (Swagger).
    location /api/ {
        set $backend_upstream ${BACKEND_UPSTREAM};
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Admin-Gate $forwarded_admin_gate;
        # A little over the 10 MB a file may take: the multipart wrapper must fit too, so the API
        # answers an oversized file itself, in JSON and in Russian.
        client_max_body_size 11m;
    }

    # Sign-in, sign-up and email codes: a password or a 6-digit code must not be guessed at speed.
    # Generous for people (10 a second, bursts of 30), a wall for a script.
    location /api/v1/auth/ {
        limit_req zone=auth burst=30 nodelay;
        set $backend_upstream ${BACKEND_UPSTREAM};
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Admin-Gate $forwarded_admin_gate;
    }

    # Reading a resume waits for the model (up to a minute, more when other requests hold its
    # slots): the default 60 s would cut it off.
    location = /api/v1/candidates/me/resume {
        set $backend_upstream ${BACKEND_UPSTREAM};
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Admin-Gate $forwarded_admin_gate;
        client_max_body_size 11m;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }

    # Live notifications (SSE): one long response, passed on as it is written. The backend sends
    # a keepalive every 25 s, well inside the read timeout.
    location = /api/v1/notifications/stream {
        set $backend_upstream ${BACKEND_UPSTREAM};
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Admin-Gate $forwarded_admin_gate;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 1h;
        # Every open stream holds a connection; the backend also caps them per account.
        limit_conn streams 30;
    }

    # Vite fingerprints everything under /assets, so it can be cached forever
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # SPA fallback; index.html itself must never be cached
    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        try_files $uri $uri/ /index.html;
    }
}
