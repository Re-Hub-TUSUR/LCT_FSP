# Browser password for the admin subdomain. The dialog is auth_basic; the app session
# is opened afterwards by a header only this proxy may set.
server {
    listen 80;
    absolute_redirect off;
    auth_basic "Админка";
    auth_basic_user_file /etc/nginx/admin.htpasswd;

    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    client_max_body_size 10m;

    location = /healthz {
        auth_basic off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # The document passes the dialog. fetch() often does not resend that password,
    # and a second 401 opens the dialog again. The cookie below is issued only after
    # the dialog succeeded, and API calls present it instead.
    location = /_gate_cookie {
        internal;
        auth_basic off;
        if ($cookie_kadry_gate = "${ADMIN_GATE_SECRET}") {
            return 204;
        }
        return 403;
    }

    location /api/ {
        auth_basic off;
        auth_request /_gate_cookie;
        set $frontend ${FRONTEND_UPSTREAM};
        proxy_pass $frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_x_kadry_access;
        proxy_set_header X-Admin-Gate ${ADMIN_GATE_SECRET};
        proxy_hide_header WWW-Authenticate;
    }

    location / {
        set $frontend ${FRONTEND_UPSTREAM};
        proxy_pass $frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_x_kadry_access;
        proxy_set_header X-Admin-Gate ${ADMIN_GATE_SECRET};
        proxy_hide_header WWW-Authenticate;
        add_header Set-Cookie "kadry_gate=${ADMIN_GATE_SECRET}; Path=/; HttpOnly; SameSite=Lax" always;
    }
}
